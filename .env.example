# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide your MongoDB Atlas or local MongoDB URI
# If left empty in development, an embedded in-memory MongoDB will automatically start for instant zero-config testing!
MONGODB_URI=mongodb://localhost:27017/pixelforge_ai

# JWT Secret for Authentication
JWT_SECRET=super_secret_jwt_key_pixelforge_2026_change_in_production
JWT_EXPIRES_IN=7d

# AI Image Generation Configuration
# Supported providers: pollinations, openai, huggingface
AI_PROVIDER=pollinations
AI_API_KEY=

# Optional Provider Keys (if using openai or huggingface)
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=

# Image Storage Configuration
# Supported: local, cloudinary, s3
STORAGE_PROVIDER=local

# Optional Cloudinary Configuration (if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional S3 / R2 Configuration (if STORAGE_PROVIDER=s3)
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

